*.jou
*.log
*.str
*.webtalk
*.wdb
*.pb
*.html
*.xml
*.backup.jou
*.backup.log

vivado_project/

# Vitis
.clangd

.cache/
.hw/
.ip_user_files/
.sim/
.runs/
.xgui/
.Xil/
*.tmp
*.xpr           # Optional: track if you use GUI workflows

vitis_project/

# SDK and Petalinux (if used)
.sdk/
*.sdk/

# Editor and OS files
.vscode/
*.swp
.DS_Store


# Routing analysis report dumps (regenerable)
routing_analysis/
analysis_*/

# Vitis scripting workspace (generated by scripts/create_vitis_project.py)
vitis_workspace/

# Overnight build scripts + logs (regenerable)
build_logs/
programmable_logic/sim/lfp_blk_*.hex
remote/ripple_envelope.csv

# Python bytecode cache
__pycache__/
*.pyc

# Generated simulation vectors and plots -- reproduce with the sim's gen_*.py
# script or design_lfp_filters.py --plot. Filter COEFFICIENTS (*_coefs.hex) ARE
# tracked: they are what the shipped hardware filters with.
programmable_logic/sim/*_samples.hex
programmable_logic/sim/*_exp.hex
programmable_logic/sim/*_exp_*.hex
programmable_logic/sim/*.png
# Belt and braces: the coefficients are the filter that ships in the bitstream,
# so never let a broader pattern above hide them.
!programmable_logic/sim/*_coefs.hex
